{
  // This is the BUILD SOURCE for the course image -- it is the only
  // devcontainer.json in the whole course that is allowed to list
  // "features". Activity repos reference the resulting image by tag and
  // must stay feature-free, otherwise students pay the feature-install cost
  // on every activity instead of once at image-build time.
  "name": "Paradigmas UDESA (image build)",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  // None since 2026a.2 (desktop-lite and its noVNC desktop went with SFML:
  // GUIs are now web pages drawn by the host's browser).
  "features": {}
}
